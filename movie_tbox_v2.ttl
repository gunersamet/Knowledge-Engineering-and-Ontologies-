@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix time: <http://www.w3.org/2002/07/owl-time#> .
@prefix inst: <https://www.example.org/movie/instances#> .

<https://www.example.org/movie-ontology> rdf:type owl:Ontology ;
    rdfs:label "Gelişmiş Film Bilgi Grafiği Şeması v2" .

# --- MEVCUT SINIFLAR ---
foaf:Person rdf:type owl:Class .
schema:Movie rdf:type owl:Class .
schema:PerformanceRole rdf:type owl:Class .

# --- YENİ EKLENEN SINIFLAR (PHASE 2) ---
# 1. Ödüllü Film Sınıfı (Movie'nin alt sınıfı)
inst:AwardWinningMovie rdf:type owl:Class ;
    rdfs:subClassOf schema:Movie ;
    rdfs:label "Ödüllü Film" .

# 2. Yayın Platformu Sınıfı (Netflix, Amazon vb.)
inst:StreamingPlatform rdf:type owl:Class ;
    rdfs:label "Yayın Platformu" .

# --- YENİ EKLENEN ÖZELLİKLER (PROPERTIES) ---
# Makaledeki Soru-Cevap algoritmasını (Algorithm 1) desteklemek için Keywords (Anahtar kelimeler)
schema:keywords rdf:type owl:DatatypeProperty ;
    rdfs:domain schema:Movie ;
    rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
    rdfs:label "Chatbot Arama Anahtar Kelimeleri" .

# Filmin hangi platformda yayınlandığını gösteren özellik
inst:availableOnPlatform rdf:type owl:ObjectProperty ;
    rdfs:domain schema:Movie ;
    rdfs:range inst:StreamingPlatform ;
    rdfs:label "Şu platformda izlenebilir" .

# Film süresi için W3C Time Ontology (Mevcut)
time:hasDurationDescription rdf:type owl:ObjectProperty ;
    rdfs:domain schema:Movie ;
    rdfs:range time:DurationDescription .